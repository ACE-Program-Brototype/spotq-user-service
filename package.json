{
	"name": "spotq-user-service",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"test": "jest",
		"test:infisical": "infisical run -- jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"build": "tsup",
		"dev": "tsx watch src/server.ts",
		"dev:infisical": "infisical run -- tsx watch src/server.ts",
		"start": "node dist/server.js",
		"commit": "git-cz",
		"lint-staged": "biome check --staged --no-errors-on-unmatched",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "infisical run -- prisma studio",
		"perf:test": "k6 run ./test/load-test.js"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.18.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/cz-commitlint": "^21.2.0",
		"@swc/core": "^1.15.47",
		"@swc/jest": "^0.2.39",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.20.4",
		"@types/supertest": "^7.2.1",
		"commitizen": "^4.3.2",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bullmq": "^6.0.5",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"inversify": "^8.2.3",
		"ioredis": "^6.0.0",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"prom-client": "^15.1.3",
		"redis": "^6.2.0",
		"reflect-metadata": "^0.2.2",
		"zod": "^4.4.3"
	}
}
