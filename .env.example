NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
# Cloud DBs (e.g. Aiven) typically include ?sslmode=require — that is fine,
# the service strips it internally and controls SSL via DATABASE_SSL_ENABLED below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/user_db

# Set to true in production to enforce SSL certificate chain verification.
# Requires a CA cert at .certs/ca.pem or set DATABASE_CA_CERT to the cert path.
# Set to false (default) for local dev — still uses SSL but skips cert verification.
DATABASE_SSL_ENABLED=false

# Optional: absolute or relative path to the CA certificate file.
# Only used when DATABASE_SSL_ENABLED=true.
# Falls back to .certs/ca.pem automatically if this is not set.
# DATABASE_CA_CERT=.certs/ca.pem

REDIS_URL=redis://localhost:6379

SERVICE_NAME=spotq-user-service

LOG_LEVEL=info

INFISICAL_TOKEN=infisical_service_token

# Bcrypt Password Hashing
BCRYPT_SALT_ROUNDS=10

# JWT & Session Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@spotq.com
BREVO_SENDER_NAME=SpotQ

# OTP Settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_for_spotq_services